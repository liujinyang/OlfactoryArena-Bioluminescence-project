; C8855-01.inf
; Copyright (c) 2018-2020 Hamamatsu Photonics K.K.
[Version]
Signature = "$Windows NT$"
Class     = USBDevice
ClassGUID = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider  = %ManufacturerName%
CatalogFile = c8855-01.cat
DriverVer   = 03/06/2020, 3.2.0.0

; ========== Manufacturer/Models sections ===========

[Manufacturer]
%ManufacturerName% = Standard,NTx86.6.2,NTx86.6.1,NTx86.6,NTx86.5,NTamd64.6.2,NTamd64.6.1,NTamd64.6,NTamd64.5

; Win8/8.1/10 support
[Standard.NTx86.6.2]
%DeviceName% =USB_Install, USB\VID_0661&PID_1300

; Win7 support is removed
[Standard.NTx86.6.1]

; Vista support is removed
[Standard.NTx86.6]

; XP support is removed
[Standard.NTx86.5]

; Win8/8.1/10 support
[Standard.NTamd64.6.2]
%DeviceName% =USB_Install, USB\VID_0661&PID_1300

; Win7 support is removed
[Standard.NTamd64.6.1]

; Vista support is removed
[Standard.NTamd64.6]

; XP support is removed
[Standard.NTamd64.5]

; =================== UnInstallation ===================

[DefaultUnInstall.NTx86]
DelFiles=C8855-01api_CopyFiles.NTx86

[DefaultUnInstall.NTamd64]
DelFiles=C8855-01api_CopyFiles.NTamd64
DelFiles=C8855-01api_CopyFiles.SysWOW64

; =================== Installation ===================

[USB_Install.NTx86]
DriverVer   = 03/06/2020, 3.2.0.0
Include = winusb.inf
Needs   = WINUSB.NT
CopyFiles = libusb_CopyFiles.NTx86,C8855-01api_CopyFiles.NTx86

[USB_Install.NTx86.Services]
Include =winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.NTx86.HW]
AddReg=Dev_AddReg

[USB_Install.NTamd64]
DriverVer   = 03/06/2020, 3.2.0.0
Include = winusb.inf
Needs   = WINUSB.NT
CopyFiles = libusb_CopyFiles.NTamd64,C8855-01api_CopyFiles.NTamd64
CopyFiles = libusb_CopyFiles.SysWOW64,C8855-01api_CopyFiles.SysWOW64

[USB_Install.NTamd64.Services]
Include =winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.NTamd64.HW]
AddReg=Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{45B708DB-DA02-4AAF-94F3-25D99F229A22}"
HKR,,FriendlyName,,%DeviceName%
HKR,,Description,,%DeviceName%

[libusb_CopyFiles.NTx86]
libusb-1.0.dll,,,34

[libusb_CopyFiles.NTamd64]
libusb-1.0.dll,libusb-1.0.dl_,,34

[libusb_CopyFiles.SysWOW64]
libusb-1.0.dll,,,34

[C8855-01api_CopyFiles.NTx86]
C8855-01api.dll,,,34

[C8855-01api_CopyFiles.NTamd64]
C8855-01api.dll,C8855-01api.dl_,,34

[C8855-01api_CopyFiles.SysWOW64]
C8855-01api.dll,,,34

[DestinationDirs]
libusb_CopyFiles.NTx86=11
libusb_CopyFiles.NTamd64=11
libusb_CopyFiles.SysWOW64=10,SysWOW64
C8855-01api_CopyFiles.NTx86=11
C8855-01api_CopyFiles.NTamd64=11
C8855-01api_CopyFiles.SysWOW64=10,SysWOW64

; ================= Source Media Section =====================

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
libusb-1.0.dll = 1,x86
libusb-1.0.dl_ = 1,x64
C8855-01api.dll = 1,x86
C8855-01api.dl_ = 1,x64

; =================== Strings ===================

[Strings]
ManufacturerName="Hamamatsu Photonics K.K."
DeviceName="Hamamatsu C8855-01"
DiskName="C8855-01 Install Disk"